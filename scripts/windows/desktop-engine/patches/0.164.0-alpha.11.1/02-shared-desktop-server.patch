diff --git a/codex-rs/app-server-transport/src/transport/named_pipe.rs b/codex-rs/app-server-transport/src/transport/named_pipe.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2dd001cad2e88a64b85b7aa255adbd05c0949c2b
--- /dev/null
+++ b/codex-rs/app-server-transport/src/transport/named_pipe.rs
@@ -0,0 +1,202 @@
+//! An additional local JSONL connection to a Desktop-owned stdio app-server.
+
+use super::CHANNEL_CAPACITY;
+use super::ConnectionOrigin;
+use super::TransportEvent;
+use super::forward_incoming_message;
+use super::next_connection_id;
+use super::serialize_outgoing_message;
+use crate::outgoing_message::QueuedOutgoingMessage;
+use std::io;
+use std::os::windows::io::AsRawHandle;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::io::BufReader;
+use tokio::net::windows::named_pipe::NamedPipeServer;
+use tokio::net::windows::named_pipe::ServerOptions;
+use tokio::sync::mpsc;
+use tokio::task::JoinHandle;
+use tokio_util::sync::CancellationToken;
+use tracing::warn;
+
+pub async fn start_named_pipe_acceptor(
+    pipe_name: String,
+    transport_event_tx: mpsc::Sender<TransportEvent>,
+    shutdown: CancellationToken,
+) -> io::Result<JoinHandle<()>> {
+    let mut first_options = ServerOptions::new();
+    first_options
+        .first_pipe_instance(true)
+        .reject_remote_clients(true);
+    let first = first_options.create(&pipe_name)?;
+
+    Ok(tokio::spawn(async move {
+        let mut waiting = first;
+        loop {
+            let result = tokio::select! {
+                result = waiting.connect() => result,
+                _ = shutdown.cancelled() => break,
+            };
+            if let Err(error) = result {
+                warn!(%error, "named pipe accept failed");
+                break;
+            }
+            let connected = waiting;
+            let mut next_options = ServerOptions::new();
+            next_options.reject_remote_clients(true);
+            match next_options.create(&pipe_name) {
+                Ok(next) => waiting = next,
+                Err(error) => {
+                    warn!(%error, "named pipe listener replacement failed");
+                    break;
+                }
+            }
+            if let Err(error) =
+                codex_uds::ensure_current_user_named_pipe_peer(connected.as_raw_handle())
+            {
+                warn!(%error, "rejecting named pipe peer");
+                continue;
+            }
+            tokio::spawn(serve_connection(
+                connected,
+                transport_event_tx.clone(),
+                shutdown.clone(),
+            ));
+        }
+    }))
+}
+
+async fn serve_connection(
+    pipe: NamedPipeServer,
+    transport_event_tx: mpsc::Sender<TransportEvent>,
+    shutdown: CancellationToken,
+) {
+    let connection_id = next_connection_id();
+    let disconnect = CancellationToken::new();
+    let (writer_tx, mut writer_rx) = mpsc::channel::<QueuedOutgoingMessage>(CHANNEL_CAPACITY);
+    if transport_event_tx
+        .send(TransportEvent::ConnectionOpened {
+            connection_id,
+            origin: ConnectionOrigin::NamedPipe,
+            auth: None,
+            writer: writer_tx.clone(),
+            disconnect_sender: Some(disconnect.clone()),
+        })
+        .await
+        .is_err()
+    {
+        return;
+    }
+
+    let (reader, mut writer) = tokio::io::split(pipe);
+    let mut lines = BufReader::new(reader).lines();
+    let reader = async {
+        loop {
+            match lines.next_line().await {
+                Ok(Some(line)) => {
+                    if !forward_incoming_message(
+                        &transport_event_tx,
+                        &writer_tx,
+                        connection_id,
+                        &line,
+                    )
+                    .await
+                    {
+                        break;
+                    }
+                }
+                Ok(None) => break,
+                Err(error) => {
+                    warn!(%error, "named pipe read failed");
+                    break;
+                }
+            }
+        }
+    };
+    let writer = async {
+        while let Some(queued) = writer_rx.recv().await {
+            let Some(mut json) = serialize_outgoing_message(queued.message) else {
+                continue;
+            };
+            json.push('\n');
+            if let Err(error) = writer.write_all(json.as_bytes()).await {
+                warn!(%error, "named pipe write failed");
+                break;
+            }
+            if let Some(written) = queued.write_complete_tx {
+                let _ = written.send(());
+            }
+        }
+    };
+    tokio::select! {
+        _ = reader => {}
+        _ = writer => {}
+        _ = disconnect.cancelled() => {}
+        _ = shutdown.cancelled() => {}
+    }
+    let _ = transport_event_tx
+        .send(TransportEvent::ConnectionClosed { connection_id })
+        .await;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use codex_app_server_protocol::JSONRPCMessage;
+    use tokio::net::windows::named_pipe::ClientOptions;
+    use tokio::time::Duration;
+    use tokio::time::timeout;
+
+    #[tokio::test]
+    async fn named_pipe_accepts_current_user_jsonl_and_reports_close() -> io::Result<()> {
+        let pipe_name = format!(r"\\.\pipe\codex-app-server-test-{}", uuid::Uuid::now_v7());
+        let (events_tx, mut events_rx) = mpsc::channel(16);
+        let shutdown = CancellationToken::new();
+        let listener =
+            start_named_pipe_acceptor(pipe_name.clone(), events_tx, shutdown.clone()).await?;
+        let mut client = ClientOptions::new().open(&pipe_name)?;
+        let opened = timeout(Duration::from_secs(5), events_rx.recv())
+            .await
+            .map_err(io::Error::other)?
+            .ok_or_else(|| io::Error::other("transport event channel closed"))?;
+        let connection_id = match opened {
+            TransportEvent::ConnectionOpened {
+                connection_id,
+                origin: ConnectionOrigin::NamedPipe,
+                disconnect_sender: Some(_),
+                ..
+            } => connection_id,
+            other => return Err(io::Error::other(format!("unexpected event: {other:?}"))),
+        };
+
+        client
+            .write_all(b"{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{}}\n")
+            .await?;
+        let incoming = timeout(Duration::from_secs(5), events_rx.recv())
+            .await
+            .map_err(io::Error::other)?
+            .ok_or_else(|| io::Error::other("transport event channel closed"))?;
+        assert!(matches!(
+            incoming,
+            TransportEvent::IncomingMessage {
+                connection_id: observed,
+                message: JSONRPCMessage::Request(_),
+            } if observed == connection_id
+        ));
+
+        drop(client);
+        let closed = timeout(Duration::from_secs(5), events_rx.recv())
+            .await
+            .map_err(io::Error::other)?
+            .ok_or_else(|| io::Error::other("transport event channel closed"))?;
+        assert!(matches!(
+            closed,
+            TransportEvent::ConnectionClosed {
+                connection_id: observed,
+            } if observed == connection_id
+        ));
+        shutdown.cancel();
+        listener.await.map_err(io::Error::other)?;
+        Ok(())
+    }
+}
