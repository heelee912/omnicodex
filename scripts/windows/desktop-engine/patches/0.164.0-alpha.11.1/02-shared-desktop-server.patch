index 0000000000000000000000000000000000000000..377fa4d5b03307bb835376d329078aa73e0bfe9c
--- /dev/null
+++ b/codex-rs/app-server/src/desktop_discovery.rs
@@ -0,0 +1,72 @@
+use serde::Serialize;
+use std::io;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+
+const DISCOVERY_DIRECTORY: &str = "shared-app-server";
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct DesktopAppServerRecord<'a> {
+    schema_version: u8,
+    pid: u32,
+    pipe_name: &'a str,
+    executable_path: String,
+    app_server_version: &'static str,
+    instance_nonce: &'a str,
+    started_at_unix_ms: u128,
+}
+
+pub(crate) struct DesktopAppServerDiscovery {
+    path: PathBuf,
+    pub(crate) pipe_name: String,
+    nonce: String,
+}
+
+impl DesktopAppServerDiscovery {
+    pub(crate) async fn prepare(codex_home: &Path) -> io::Result<Self> {
+        let directory = codex_home.join(DISCOVERY_DIRECTORY);
+        codex_uds::prepare_private_socket_directory(&directory).await?;
+        let pid = std::process::id();
+        let nonce = uuid::Uuid::now_v7().to_string();
+        let pipe_name = format!(r"\\.\pipe\codex-app-server-{pid}-{nonce}");
+        let path = directory.join(format!("desktop-app-server-{pid}-{nonce}.json"));
+        Ok(Self {
+            path,
+            pipe_name,
+            nonce,
+        })
+    }
+
+    pub(crate) fn publish(&self) -> io::Result<()> {
+        let pid = std::process::id();
+        let temporary = self.path.with_extension("tmp");
+        let record = DesktopAppServerRecord {
+            schema_version: 1,
+            pid,
+            pipe_name: &self.pipe_name,
+            executable_path: std::env::current_exe()?.to_string_lossy().into_owned(),
+            app_server_version: env!("CARGO_PKG_VERSION"),
+            instance_nonce: &self.nonce,
+            started_at_unix_ms: SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .map_err(io::Error::other)?
+                .as_millis(),
+        };
+        let json = serde_json::to_vec(&record).map_err(io::Error::other)?;
+        std::fs::write(&temporary, json)?;
+        if let Err(error) = std::fs::rename(&temporary, &self.path) {
+            let _ = std::fs::remove_file(&temporary);
+            return Err(error);
+        }
+        Ok(())
+    }
+}
+
+impl Drop for DesktopAppServerDiscovery {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.path);
+    }
+}
