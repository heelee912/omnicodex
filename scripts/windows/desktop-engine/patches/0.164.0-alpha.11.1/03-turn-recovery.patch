+use super::*;
+use codex_extension_api::ExtensionData;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+use std::sync::Mutex;
+use std::time::Duration;
+
+fn recording_watch(store: &ExtensionData) -> (TurnPhaseWatch, Arc<Mutex<Vec<TurnPhaseStall>>>) {
+    let reports = Arc::new(Mutex::new(Vec::new()));
+    let sink = Arc::clone(&reports);
+    let watch = TurnPhaseWatch::start(store, move |stall| {
+        sink.lock().expect("report sink").push(stall);
+    });
+    (watch, reports)
+}
+
+fn reported_phases(reports: &Mutex<Vec<TurnPhaseStall>>) -> Vec<&'static str> {
+    reports
+        .lock()
+        .expect("report sink")
+        .iter()
+        .map(|stall| stall.phase)
+        .collect()
+}
+
+#[tokio::test(start_paused = true)]
+async fn stalled_preparation_phase_is_reported_by_name_and_repeated() {
+    let store = ExtensionData::new("turn");
+    let (_watch, reports) = recording_watch(&store);
+    advance_turn_phase(&store, TurnPhase::preparation("step.world_state"));
+
+    tokio::time::sleep(Duration::from_secs(55)).await;
+    assert_eq!(reported_phases(&reports), Vec::<&str>::new());
+
+    tokio::time::sleep(Duration::from_secs(10)).await;
+    assert_eq!(reported_phases(&reports), vec!["step.world_state"]);
+    let first_wait = reports.lock().expect("report sink")[0].waited;
+    assert!(first_wait >= TURN_PHASE_STALL_REPORT_AFTER);
+
+    // One report per repeat interval, not one per poll.
+    tokio::time::sleep(Duration::from_secs(240)).await;
+    assert_eq!(reported_phases(&reports).len(), 1);
+    tokio::time::sleep(Duration::from_secs(70)).await;
+    assert_eq!(
+        reported_phases(&reports),
+        vec!["step.world_state", "step.world_state"]
+    );
+}
+
+#[tokio::test(start_paused = true)]
+async fn long_model_work_is_not_reported_and_next_preparation_starts_fresh() {
+    let store = ExtensionData::new("turn");
+    let (_watch, reports) = recording_watch(&store);
+    advance_turn_phase(&store, TurnPhase::model_work("sampling.model"));
+
+    tokio::time::sleep(Duration::from_secs(60 * 60)).await;
+    assert_eq!(reported_phases(&reports), Vec::<&str>::new());
+
+    advance_turn_phase(&store, TurnPhase::preparation("step.post_sampling"));
+    tokio::time::sleep(Duration::from_secs(30)).await;
+    assert_eq!(reported_phases(&reports), Vec::<&str>::new());
+    tokio::time::sleep(Duration::from_secs(35)).await;
+    assert_eq!(reported_phases(&reports), vec!["step.post_sampling"]);
+}
+
+#[tokio::test(start_paused = true)]
+async fn advancing_phase_resets_the_stall_clock() {
+    let store = ExtensionData::new("turn");
+    let (_watch, reports) = recording_watch(&store);
+    for phase in ["step.capture", "step.time_reminder", "step.world_state"] {
+        advance_turn_phase(&store, TurnPhase::preparation(phase));
+        tokio::time::sleep(Duration::from_secs(50)).await;
+    }
+    assert_eq!(reported_phases(&reports), Vec::<&str>::new());
+}
+
+#[tokio::test(start_paused = true)]
+async fn dropping_the_watch_stops_reports() {
+    let store = ExtensionData::new("turn");
+    let (watch, reports) = recording_watch(&store);
+    advance_turn_phase(&store, TurnPhase::preparation("turn.step_capture"));
+    drop(watch);
+
+    tokio::time::sleep(Duration::from_secs(10 * 60)).await;
+    assert_eq!(reported_phases(&reports), Vec::<&str>::new());
+}
