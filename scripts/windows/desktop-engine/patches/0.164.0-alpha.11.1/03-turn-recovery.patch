index 0000000000000000000000000000000000000000..f990397865523cc91f85b067ac96b306a112a191
--- /dev/null
+++ b/codex-rs/core/src/tasks/unrecorded_input_tests.rs
@@ -0,0 +1,252 @@
+//! A turn accepts user input before preparation (pre-turn compaction, step capture,
+//! initial context) has finished. Interrupting or failing during that window must still
+//! leave the input in history, exactly once and ahead of the interrupt marker.
+
+use super::SessionTask;
+use super::SessionTaskResult;
+use crate::session::TurnInput;
+use crate::session::UserInputMetadata;
+use crate::session::session::Session;
+use crate::session::tests::make_session_and_context_with_rx;
+use crate::session::turn::UnrecordedTurnInput;
+use crate::session::turn::stash_unrecorded_turn_input;
+use crate::session::turn::take_unrecorded_turn_input;
+use crate::session::turn_context::TurnContext;
+use crate::state::TaskKind;
+use codex_protocol::error::CodexErr;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::TurnAbortReason;
+use codex_protocol::user_input::UserInput;
+use pretty_assertions::assert_eq;
+use std::sync::Arc;
+use std::time::Duration;
+use tokio_util::sync::CancellationToken;
+
+const SUBMITTED_TEXT: &str = "keep this request across an interrupted preparation";
+
+/// Holds input like `run_turn` does before it is recorded, then stops or fails there.
+struct StalledPreparationTask {
+    fail: bool,
+}
+
+impl SessionTask for StalledPreparationTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+
+    fn span_name(&self) -> &'static str {
+        "session_task.stalled_preparation"
+    }
+
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        turn_context: Arc<TurnContext>,
+        input: Vec<TurnInput>,
+        _cancellation_token: CancellationToken,
+    ) -> SessionTaskResult {
+        stash_unrecorded_turn_input(&turn_context.extension_data, &input);
+        if self.fail {
+            return Err(CodexErr::Fatal("preparation failed".to_string()));
+        }
+        std::future::pending().await
+    }
+}
+
+/// Panics after holding its input, like a debug-build invariant check inside a turn.
+struct PanickingPreparationTask;
+
+impl SessionTask for PanickingPreparationTask {
+    fn kind(&self) -> TaskKind {
+        TaskKind::Regular
+    }
+
+    fn span_name(&self) -> &'static str {
+        "session_task.panicking_preparation"
+    }
+
+    async fn run(
+        self: Arc<Self>,
+        _session: Arc<Session>,
+        turn_context: Arc<TurnContext>,
+        input: Vec<TurnInput>,
+        _cancellation_token: CancellationToken,
+    ) -> SessionTaskResult {
+        stash_unrecorded_turn_input(&turn_context.extension_data, &input);
+        panic!("simulated invariant failure in turn task");
+    }
+}
+
+fn submitted_input() -> Vec<TurnInput> {
+    vec![TurnInput::UserInput {
+        content: vec![UserInput::Text {
+            text: SUBMITTED_TEXT.to_string(),
+            text_elements: Vec::new(),
+        }],
+        client_id: None,
+        metadata: UserInputMetadata::default(),
+    }]
+}
+
+async fn user_message_texts(session: &Session) -> Vec<String> {
+    session
+        .clone_history()
+        .await
+        .raw_items()
+        .filter_map(|item| match item {
+            ResponseItem::Message { role, content, .. } if role == "user" => Some(
+                content
+                    .iter()
+                    .filter_map(|content| match content {
+                        ContentItem::InputText { text } => Some(text.as_str()),
+                        _ => None,
+                    })
+                    .collect::<String>(),
+            ),
+            _ => None,
+        })
+        .collect()
+}
+
+fn submitted_positions(texts: &[String]) -> Vec<usize> {
+    texts
+        .iter()
+        .enumerate()
+        .filter(|(_, text)| text.contains(SUBMITTED_TEXT))
+        .map(|(index, _)| index)
+        .collect()
+}
+
+async fn wait_until_input_is_held(turn_context: &TurnContext) {
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while turn_context
+            .extension_data
+            .get::<UnrecordedTurnInput>()
+            .is_none()
+        {
+            tokio::task::yield_now().await;
+        }
+    })
+    .await
+    .expect("task should hold its input before stalling");
+}
+
+#[tokio::test]
+async fn interrupt_during_preparation_records_input_once_before_marker() {
+    let (session, turn_context, _rx) = make_session_and_context_with_rx().await;
+    session
+        .spawn_task(
+            Arc::clone(&turn_context),
+            submitted_input(),
+            StalledPreparationTask { fail: false },
+        )
+        .await;
+    wait_until_input_is_held(&turn_context).await;
+
+    session.abort_all_tasks(TurnAbortReason::Interrupted).await;
+
+    let texts = user_message_texts(&session).await;
+    let submitted = submitted_positions(&texts);
+    assert_eq!(
+        submitted.len(),
+        1,
+        "input must be recorded exactly once: {texts:?}"
+    );
+    if let Some(marker) = texts
+        .iter()
+        .position(|text| text.contains("<turn_aborted>"))
+    {
+        assert!(
+            submitted[0] < marker,
+            "input must precede the interrupt marker: {texts:?}"
+        );
+    }
+    assert!(
+        turn_context
+            .extension_data
+            .get::<UnrecordedTurnInput>()
+            .is_none()
+    );
+}
+
+#[tokio::test]
+async fn failed_preparation_records_input() {
+    let (session, turn_context, _rx) = make_session_and_context_with_rx().await;
+    session
+        .spawn_task(
+            Arc::clone(&turn_context),
+            submitted_input(),
+            StalledPreparationTask { fail: true },
+        )
+        .await;
+
+    tokio::time::timeout(Duration::from_secs(5), async {
+        while submitted_positions(&user_message_texts(&session).await).is_empty() {
+            tokio::time::sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("failed turn should record its submitted input");
+    assert_eq!(
+        submitted_positions(&user_message_texts(&session).await).len(),
+        1
+    );
+}
+
+#[tokio::test]
+async fn input_already_recorded_by_the_turn_is_not_recorded_again() {
+    let (session, turn_context, _rx) = make_session_and_context_with_rx().await;
+    stash_unrecorded_turn_input(&turn_context.extension_data, &submitted_input());
+    // The turn's own recording path takes ownership before it writes the input.
+    assert!(take_unrecorded_turn_input(&turn_context.extension_data).is_some());
+
+    let recorded =
+        crate::session::turn::record_unrecorded_turn_input(&session, &turn_context).await;
+
+    assert!(!recorded);
+    assert_eq!(
+        submitted_positions(&user_message_texts(&session).await),
+        Vec::<usize>::new()
+    );
+}
+
+/// A panic inside the turn task used to skip the finish path, leaving the turn active
+/// with no terminal event, so clients showed it as thinking forever.
+#[tokio::test]
+async fn panicking_turn_task_reports_error_completes_and_keeps_input() {
+    let (session, turn_context, rx) = make_session_and_context_with_rx().await;
+    session
+        .spawn_task(
+            Arc::clone(&turn_context),
+            submitted_input(),
+            PanickingPreparationTask,
+        )
+        .await;
+
+    let error_message = tokio::time::timeout(Duration::from_secs(5), async {
+        let mut error_message = None;
+        loop {
+            let event = rx.recv().await.expect("session events should stay open");
+            match event.msg {
+                EventMsg::Error(error) => error_message = Some(error.message),
+                EventMsg::TurnComplete(_) => return error_message,
+                _ => {}
+            }
+        }
+    })
+    .await
+    .expect("a panicked turn must still complete");
+
+    assert!(
+        error_message
+            .as_deref()
+            .is_some_and(|message| message.contains("turn task panicked")),
+        "the panic must surface as the turn's error: {error_message:?}"
+    );
+    assert_eq!(
+        submitted_positions(&user_message_texts(&session).await).len(),
+        1
+    );
+}
