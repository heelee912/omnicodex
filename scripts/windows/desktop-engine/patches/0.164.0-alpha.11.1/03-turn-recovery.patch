+
+struct StallWorldState {
+    calls: AtomicUsize,
+    stall_call: usize,
+}
+
+impl ContextContributor for StallWorldState {
+    fn contribute_world_state<'a>(
+        &'a self,
+        _input: WorldStateContributionInput<'a>,
+    ) -> ExtensionFuture<'a, Vec<WorldStateSectionContribution>> {
+        Box::pin(async move {
+            if self.calls.fetch_add(1, Ordering::SeqCst) == self.stall_call {
+                std::future::pending::<()>().await;
+            }
+            Vec::new()
+        })
+    }
+}
+
+#[test]
+fn stalled_second_world_state_build_uses_initial_context_and_reaches_model() -> Result<()> {
+    run_test_with_large_stack("world_state_timeout", test_stalled_second_world_state_build)
+}
+
+async fn test_stalled_second_world_state_build() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    let mock = mount_sse_sequence(
+        &server,
+        vec![sse(vec![
+            ev_assistant_message("answer", "The request completed."),
+            ev_completed("response"),
+        ])],
+    )
+    .await;
+    let stalled_context = Arc::new(StallWorldState {
+        calls: AtomicUsize::new(0),
+        stall_call: 1,
+    });
+    let mut extensions = ExtensionRegistryBuilder::<Config>::new();
+    extensions.prompt_contributor(stalled_context.clone());
+    let test = test_codex()
+        .with_extensions(Arc::new(extensions.build()))
+        .build_with_auto_env(&server)
+        .await?;
+
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Answer this request.".to_string(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    let mut warned = false;
+    let mut answered = false;
+    wait_for_event_with_timeout(
+        &test.codex,
+        |event| {
+            assert!(!matches!(event, EventMsg::Error(_)), "{event:?}");
+            if let EventMsg::Warning(warning) = event {
+                warned |= warning.message.contains("Turn context refresh timed out");
+            }
+            if let EventMsg::AgentMessage(message) = event {
+                answered |= message.message == "The request completed.";
+            }
+            matches!(event, EventMsg::TurnComplete(_))
+        },
+        Duration::from_secs(45),
+    )
+    .await;
+
+    assert!(warned, "the fallback should be visible to the user");
+    assert!(answered, "the model response should be delivered");
+    assert_eq!(stalled_context.calls.load(Ordering::SeqCst), 2);
+    assert_eq!(mock.requests().len(), 1);
+    Ok(())
+}
+
+#[test]
+fn stalled_initial_world_state_build_reports_timeout_and_completes_turn() -> Result<()> {
+    run_test_with_large_stack(
+        "initial_world_state_timeout",
+        test_stalled_initial_world_state_build,
+    )
+}
+
+async fn test_stalled_initial_world_state_build() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    let stalled_context = Arc::new(StallWorldState {
+        calls: AtomicUsize::new(0),
+        stall_call: 0,
+    });
+    let mut extensions = ExtensionRegistryBuilder::<Config>::new();
+    extensions.prompt_contributor(stalled_context.clone());
+    let test = test_codex()
+        .with_extensions(Arc::new(extensions.build()))
+        .build_with_auto_env(&server)
+        .await?;
+
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Answer this request.".to_string(),
+            text_elements: Vec::new(),
+        }]))
+        .await?;
+    let mut timed_out = false;
+    wait_for_event_with_timeout(
+        &test.codex,
+        |event| {
+            if matches!(event, EventMsg::Error(_)) {
+                timed_out = true;
+            }
+            matches!(event, EventMsg::TurnComplete(_))
+        },
+        Duration::from_secs(45),
+    )
+    .await;
+
+    assert!(
+        timed_out,
+        "the stalled initial context should report an error"
+    );
+    assert_eq!(stalled_context.calls.load(Ordering::SeqCst), 1);
+    assert!(server.received_requests().await.unwrap().is_empty());
+    let history = test.codex.conversation_history_snapshot().await;
+    let history = serde_json::to_value(history.items().collect::<Vec<_>>())?;
+    assert!(
+        history
+            .as_array()
+            .is_some_and(|items| items.iter().any(|item| {
+                item["role"] == "user" && item["content"][0]["text"] == "Answer this request."
+            })),
+        "the timed-out turn should retain its user input"
+    );
+    Ok(())
+}
