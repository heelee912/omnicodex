+/// A preparation phase that has not advanced for this long is reported once,
+/// then again on every repeat interval while it keeps waiting.
+const TURN_PHASE_STALL_REPORT_AFTER: std::time::Duration = std::time::Duration::from_secs(60);
+const TURN_PHASE_STALL_REPORT_REPEAT: std::time::Duration = std::time::Duration::from_secs(300);
+const TURN_PHASE_WATCH_POLL: std::time::Duration = std::time::Duration::from_secs(5);
+
+/// Whether time spent in a phase can be legitimate model work.
+///
+/// Model streaming, tool execution, and compaction requests may run for a long
+/// time, so they are never reported. Preparation phases wait only on local
+/// state, locks, or startup work; a long wait there is a silent stall.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum TurnPhaseKind {
+    Preparation,
+    ModelWork,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct TurnPhase {
+    pub(crate) name: &'static str,
+    pub(crate) kind: TurnPhaseKind,
+}
+
+impl TurnPhase {
+    pub(crate) const fn preparation(name: &'static str) -> Self {
+        Self {
+            name,
+            kind: TurnPhaseKind::Preparation,
+        }
+    }
+
+    pub(crate) const fn model_work(name: &'static str) -> Self {
+        Self {
+            name,
+            kind: TurnPhaseKind::ModelWork,
+        }
+    }
+}
+
+struct TurnPhaseState {
+    phase: TurnPhase,
+    entered_at: tokio::time::Instant,
+    last_reported_at: Option<tokio::time::Instant>,
+}
+
+/// Last checkpoint a turn reached, shared through the turn's extension store so
+/// compaction and sampling helpers can advance it without new parameters.
+pub(crate) struct TurnPhaseMarker {
+    state: std::sync::Mutex<TurnPhaseState>,
+}
+
+impl TurnPhaseMarker {
+    fn new(phase: TurnPhase) -> Self {
+        Self {
+            state: std::sync::Mutex::new(TurnPhaseState {
+                phase,
+                entered_at: tokio::time::Instant::now(),
+                last_reported_at: None,
+            }),
+        }
+    }
+
+    fn enter(&self, phase: TurnPhase) {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        *state = TurnPhaseState {
+            phase,
+            entered_at: tokio::time::Instant::now(),
+            last_reported_at: None,
+        };
+    }
+
+    fn take_stall(&self, now: tokio::time::Instant) -> Option<TurnPhaseStall> {
+        let mut state = self
+            .state
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.phase.kind != TurnPhaseKind::Preparation {
+            return None;
+        }
+        let waited = now.saturating_duration_since(state.entered_at);
+        let due = match state.last_reported_at {
+            None => waited >= TURN_PHASE_STALL_REPORT_AFTER,
+            Some(reported_at) => {
+                now.saturating_duration_since(reported_at) >= TURN_PHASE_STALL_REPORT_REPEAT
+            }
+        };
+        if !due {
+            return None;
+        }
+        state.last_reported_at = Some(now);
+        Some(TurnPhaseStall {
+            phase: state.phase.name,
+            waited,
+        })
+    }
+}
+
+#[derive(Debug, PartialEq, Eq)]
+pub(crate) struct TurnPhaseStall {
+    pub(crate) phase: &'static str,
+    pub(crate) waited: std::time::Duration,
+}
+
+/// Records the checkpoint at TRACE level and advances the turn's stall watch.
+pub(crate) fn mark_turn_phase(turn_context: &TurnContext, phase: TurnPhase) {
+    trace!(turn_id = %turn_context.sub_id, phase = phase.name, "turn phase entered");
+    advance_turn_phase(&turn_context.extension_data, phase);
+}
+
+fn advance_turn_phase(turn_store: &codex_extension_api::ExtensionData, phase: TurnPhase) {
+    if let Some(marker) = turn_store.get::<TurnPhaseMarker>() {
+        marker.enter(phase);
+    }
+}
+
+/// Reports, without failing the turn, a preparation phase that stops advancing.
+struct TurnPhaseWatch {
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl TurnPhaseWatch {
+    fn start(
+        turn_store: &codex_extension_api::ExtensionData,
+        report: impl Fn(TurnPhaseStall) + Send + Sync + 'static,
+    ) -> Self {
+        turn_store.insert(TurnPhaseMarker::new(TurnPhase::preparation("turn.start")));
+        let marker = turn_store.get::<TurnPhaseMarker>();
+        let task = tokio::spawn(async move {
+            let Some(marker) = marker else {
+                return;
+            };
+            loop {
+                tokio::time::sleep(TURN_PHASE_WATCH_POLL).await;
+                if let Some(stall) = marker.take_stall(tokio::time::Instant::now()) {
+                    report(stall);
+                }
+            }
+        });
+        Self { task }
+    }
+
+    fn start_logging(turn_context: &TurnContext, thread_id: codex_protocol::ThreadId) -> Self {
+        let turn_id = turn_context.sub_id.clone();
+        Self::start(&turn_context.extension_data, move |stall| {
+            warn!(
+                %thread_id,
+                turn_id = %turn_id,
+                phase = stall.phase,
+                waited_secs = stall.waited.as_secs(),
+                "turn phase has not advanced; still waiting"
+            );
+        })
+    }
+}
+
+impl Drop for TurnPhaseWatch {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
