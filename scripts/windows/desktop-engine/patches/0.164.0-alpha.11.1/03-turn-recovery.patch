+async fn record_input_after_preparation_error(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    input: &[TurnInput],
+) {
+    // This path records the input itself; interrupt and error handling must not repeat it.
+    take_unrecorded_turn_input(&turn_context.extension_data);
+    run_hooks_and_record_inputs(
+        sess,
+        turn_context,
+        &turn_context.capture_current_model_info(),
+        input,
+        PersistContext::Standard,
+    )
+    .await;
+}
+
+/// Turn input accepted by `run_turn` but not yet written to history.
+///
+/// Pre-turn compaction and step preparation run before the input is recorded.
+/// If that preparation is interrupted or fails, the task is dropped before it
+/// can record the input, so the finishing paths record what remains here.
+pub(crate) struct UnrecordedTurnInput {
+    input: std::sync::Mutex<Option<Vec<TurnInput>>>,
+}
+
+impl UnrecordedTurnInput {
+    fn new(input: Vec<TurnInput>) -> Self {
+        Self {
+            input: std::sync::Mutex::new(Some(input)),
+        }
+    }
+
+    fn take(&self) -> Option<Vec<TurnInput>> {
+        self.input
+            .lock()
+            .unwrap_or_else(std::sync::PoisonError::into_inner)
+            .take()
+    }
+}
+
+pub(crate) fn stash_unrecorded_turn_input(
+    turn_store: &codex_extension_api::ExtensionData,
+    input: &[TurnInput],
+) {
+    if input.is_empty() {
+        turn_store.remove::<UnrecordedTurnInput>();
+        return;
+    }
+    turn_store.insert(UnrecordedTurnInput::new(input.to_vec()));
+}
+
+pub(crate) fn take_unrecorded_turn_input(
+    turn_store: &codex_extension_api::ExtensionData,
+) -> Option<Vec<TurnInput>> {
+    turn_store.remove::<UnrecordedTurnInput>()?.take()
+}
+
+/// Records input that a dropped or failed turn never wrote, without rerunning
+/// prompt hooks: the turn is already finishing and hooks may be what stalled.
+pub(crate) async fn record_unrecorded_turn_input(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+) -> bool {
+    let Some(input) = take_unrecorded_turn_input(&turn_context.extension_data) else {
+        return false;
+    };
+    // Only finalized evidence may enter reusable Guardian reviewer history.
+    if sess
+        .services
+        .thread_extension_data
+        .get::<crate::guardian::PendingReviewContext>()
+        .is_some()
+    {
+        return false;
+    }
+    let model_info = turn_context.capture_current_model_info();
+    for input_item in input {
+        crate::hook_runtime::record_pending_input(
+            sess,
+            turn_context,
+            &model_info,
+            input_item,
+            Vec::new(),
+            PersistContext::Standard,
+        )
+        .await;
+    }
+    true
+}
