+#[tokio::test]
+async fn stale_local_call_does_not_apply_preparation() {
+    let step = test_step(
+        "old",
+        AppToolApproval::Prompt,
+        /*supports_sandbox_state_meta*/ false,
+    )
+    .await;
+    let prepared = step
+        .step
+        .prepare_call(SERVER_NAME, TOOL_NAME)
+        .expect("step should prepare the advertised tool");
+    step.tool_catalog
+        .refresh(
+            || async { Ok((step.step.tools().to_vec(), None, ())) },
+            |_, _, ()| {},
+        )
+        .await
+        .expect("refresh tool catalog");
+    let preparation_ran = Arc::new(AtomicBool::new(false));
+    let marker = Arc::clone(&preparation_ran);
+
+    let error = prepared
+        .call_local_with_preparation(|| async move {
+            marker.store(true, Ordering::SeqCst);
+            Ok(local_document_result())
+        })
+        .await
+        .expect_err("stale local call must be rejected");
+
+    assert!(format!("{error:#}").contains("catalog changed"));
+    assert!(!preparation_ran.load(Ordering::SeqCst));
+}
+
+fn local_document_result() -> CallToolResult {
+    CallToolResult {
+        content: vec![serde_json::json!({"type": "text", "text": "# 보호 문서\n\n정상입니다."})],
+        structured_content: None,
+        is_error: None,
+        meta: None,
+    }
+}
