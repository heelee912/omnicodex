+#[tokio::test]
+async fn local_call_returns_bound_result_without_contacting_server() {
+    let step = test_step(
+        "old",
+        AppToolApproval::Prompt,
+        /*supports_sandbox_state_meta*/ false,
+    )
+    .await;
+    let prepared = step
+        .step
+        .prepare_call(SERVER_NAME, TOOL_NAME)
+        .expect("step should prepare the advertised tool");
+
+    let result = prepared
+        .call_local_with_preparation(|| async { Ok(local_document_result()) })
+        .await
+        .expect("local result should not require the test server to answer");
+
+    assert_eq!(
+        result.content,
+        vec![serde_json::json!({"type": "text", "text": "# 보호 문서\n\n정상입니다."})]
+    );
+    assert_eq!(result.is_error, None);
+}
