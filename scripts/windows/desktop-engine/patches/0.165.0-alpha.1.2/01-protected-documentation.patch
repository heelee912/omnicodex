+use std::path::Path;
+
+use anyhow::Context;
+use anyhow::Result;
+use anyhow::bail;
+use codex_protocol::dynamic_tools::DynamicToolCallOutputContentItem;
+use codex_protocol::dynamic_tools::DynamicToolResponse;
+use serde_json::Value;
+use sha2::Digest;
+use sha2::Sha256;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum ProtectedDocument {
+    TinyskyAltConfirmations,
+    ChromeConfirmations,
+    ChromeBrowserSafety,
+    BrowserBrowserSafety,
+    ChromeBackupBrowserSafety,
+    BrowserSafetyTraining,
+    BrowserSafetyTrainingCuaReference,
+    AppBrowserSafety,
+    CloudBrowserSafety,
+    OrbitBrowserSafety,
+    ComputerUseGuidance,
+}
+
+impl ProtectedDocument {
+    pub(crate) fn for_call(
+        namespace: Option<&str>,
+        tool_name: &str,
+        arguments: &Value,
+    ) -> Option<Self> {
+        if arguments.get("operation")?.as_str()? != "documentation" {
+            return None;
+        }
+        let document_name = arguments
+            .get("documentation_name")?
+            .as_str()?
+            .trim()
+            .to_ascii_lowercase();
+        let document_name = document_name.strip_suffix(".md").unwrap_or(&document_name);
+        let app_browser = match (namespace, tool_name) {
+            (None, "chrome__control_chrome")
+            | (Some("chrome"), "control_chrome" | "chrome__control_chrome") => false,
+            (None, "browser__control_in_app_browser")
+            | (Some("browser"), "control_in_app_browser" | "browser__control_in_app_browser") => {
+                true
+            }
+            _ => return None,
+        };
+        match document_name {
+            "confirmations"
+            | "confirmation"
+            | "agent-confirmations-policy"
+            | "chrome-confirmations" => Some(Self::ChromeConfirmations),
+            "browser-safety" | "safety" | "policy" => Some(if app_browser {
+                Self::AppBrowserSafety
+            } else {
+                Self::ChromeBrowserSafety
+            }),
+            "computer-use-guidance" => Some(Self::ComputerUseGuidance),
+            "tinysky-alt-confirmations" => Some(Self::TinyskyAltConfirmations),
+            "chrome-browser-safety" => Some(Self::ChromeBrowserSafety),
+            "browser-browser-safety" => Some(Self::BrowserBrowserSafety),
+            "chrome-backup-browser-safety" => Some(Self::ChromeBackupBrowserSafety),
+            "browser-safety-training" => Some(Self::BrowserSafetyTraining),
+            "browser-safety-training-cua-reference" => {
+                Some(Self::BrowserSafetyTrainingCuaReference)
+            }
+            "codex-app-browser-safety" => Some(Self::AppBrowserSafety),
+            "cloud-browser-safety" => Some(Self::CloudBrowserSafety),
+            "orbit-browser-safety" => Some(Self::OrbitBrowserSafety),
+            _ => None,
+        }
+    }
+
+    fn file_name(self) -> &'static str {
+        match self {
+            Self::TinyskyAltConfirmations => "tinysky-alt-confirmations.md",
+            Self::ChromeConfirmations => "chrome-confirmations.md",
+            Self::ChromeBrowserSafety => "chrome-browser-safety.md",
+            Self::BrowserBrowserSafety => "browser-browser-safety.md",
+            Self::ChromeBackupBrowserSafety => "chrome-backup-browser-safety.md",
+            Self::BrowserSafetyTraining => "browser-safety-training.md",
+            Self::BrowserSafetyTrainingCuaReference => "browser-safety-training-cua-reference.md",
+            Self::AppBrowserSafety => "codex-app-browser-safety.md",
+            Self::CloudBrowserSafety => "cloud-browser-safety.md",
+            Self::OrbitBrowserSafety => "orbit-browser-safety.md",
+            Self::ComputerUseGuidance => "computer-use-guidance.md",
+        }
+    }
+}
+
+/// The app server uses this check to avoid requesting a document from the host.
+pub fn is_protected_dynamic_documentation_call(
+    namespace: Option<&str>,
+    tool_name: &str,
+    arguments: &Value,
+) -> bool {
+    ProtectedDocument::for_call(namespace, tool_name, arguments).is_some()
+}
+
+/// Write the verified document into the response shared by the user event and model.
+pub(crate) async fn set_protected_document_response(
+    codex_home: &Path,
+    document: ProtectedDocument,
+    response: &mut DynamicToolResponse,
+) {
+    let (markdown, success) = protected_document_text(codex_home, document).await;
+    response.content_items = vec![DynamicToolCallOutputContentItem::InputText { text: markdown }];
+    response.success = success;
+}
+
+/// Return the same verified text to dynamic and MCP tool callers.
+pub(crate) async fn protected_document_text(
+    codex_home: &Path,
+    document: ProtectedDocument,
+) -> (String, bool) {
+    let (markdown, success) = match read_verified_markdown(codex_home, document).await {
+        Ok(markdown) => (markdown, true),
+        Err(error) => {
+            tracing::warn!(file = document.file_name(), %error, "protected documentation unavailable");
+            (
+                "# 보호 문서 오류\n\n보호된 한글 Markdown을 확인할 수 없습니다.".to_string(),
+                false,
+            )
+        }
+    };
+    (markdown, success)
+}
+
+async fn read_verified_markdown(codex_home: &Path, document: ProtectedDocument) -> Result<String> {
+    let root = codex_home.join("protected-confirmation-docs");
+    let manifest_bytes = tokio::fs::read(root.join("manifest.json"))
+        .await
+        .context("protected document manifest read failed")?;
+    let manifest: Vec<Value> = serde_json::from_slice(&manifest_bytes)
+        .context("protected document manifest is not an array")?;
+    let file_name = document.file_name();
+    let entries = manifest
+        .iter()
+        .filter(|entry| {
+            entry
+                .get("Source")
+                .and_then(Value::as_str)
+                .and_then(|source| source.rsplit(|ch| ch == '/' || ch == '\\').next())
+                .is_some_and(|name| name.eq_ignore_ascii_case(file_name))
+        })
+        .collect::<Vec<_>>();
+    if entries.len() != 1 {
+        bail!("protected document manifest has no unique entry for {file_name}");
+    }
+    let expected_hash = entries[0]
+        .get("SHA256")
+        .and_then(Value::as_str)
+        .filter(|hash| hash.len() == 64 && hash.bytes().all(|byte| byte.is_ascii_hexdigit()))
+        .context("protected document manifest hash is invalid")?;
+    let markdown_bytes = tokio::fs::read(root.join(file_name))
+        .await
+        .context("protected document read failed")?;
+    let actual_hash = format!("{:x}", Sha256::digest(&markdown_bytes));
+    if !actual_hash.eq_ignore_ascii_case(expected_hash) {
+        bail!("protected document hash mismatch for {file_name}");
+    }
+    let markdown = String::from_utf8(markdown_bytes).context("protected document is not UTF-8")?;
+    let has_heading = markdown.lines().any(|line| {
+        let level = line.bytes().take_while(|byte| *byte == b'#').count();
+        (1..=6).contains(&level)
+            && line[level..]
+                .chars()
+                .next()
+                .is_some_and(|ch| ch == ' ' || ch == '\t')
+            && !line[level..].trim().is_empty()
+    });
+    let has_hangul = markdown
+        .chars()
+        .any(|ch| ('\u{AC00}'..='\u{D7A3}').contains(&ch));
+    if !has_heading || !has_hangul {
+        bail!("protected document is not Korean Markdown: {file_name}");
+    }
+    Ok(markdown)
+}
