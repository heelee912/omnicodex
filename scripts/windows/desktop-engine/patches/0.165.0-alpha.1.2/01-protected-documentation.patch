+#[test]
+fn selects_only_named_browser_policy_documents() {
+    let cases = [
+        (
+            "chrome__control_chrome",
+            "confirmations",
+            Some(ProtectedDocument::ChromeConfirmations),
+        ),
+        (
+            "chrome__control_chrome",
+            " confirmations ",
+            Some(ProtectedDocument::ChromeConfirmations),
+        ),
+        (
+            "chrome__control_chrome",
+            " CHROME-CONFIRMATIONS.MD ",
+            Some(ProtectedDocument::ChromeConfirmations),
+        ),
+        (
+            "chrome__control_chrome",
+            "browser-safety",
+            Some(ProtectedDocument::ChromeBrowserSafety),
+        ),
+        (
+            "browser__control_in_app_browser",
+            "browser-safety",
+            Some(ProtectedDocument::AppBrowserSafety),
+        ),
+        ("browser__control_in_app_browser", "core-cua-repl", None),
+        ("chrome__control_chrome", "accessibility", None),
+        ("chrome__control_chrome", "api-use-behavior", None),
+        (
+            "chrome__control_chrome",
+            "capabilities/tab/botDetection",
+            None,
+        ),
+        (
+            "chrome__control_chrome",
+            "cloud-browser-safety.md",
+            Some(ProtectedDocument::CloudBrowserSafety),
+        ),
+        (
+            "chrome__control_chrome",
+            "tinysky-alt-confirmations",
+            Some(ProtectedDocument::TinyskyAltConfirmations),
+        ),
+        ("other_tool", "confirmations", None),
+        ("chrome__control_chrome", "api", None),
+    ];
+    for (tool_name, document_name, expected) in cases {
+        let arguments = json!({
+            "operation": "documentation",
+            "documentation_name": document_name,
+        });
+        assert_eq!(
+            ProtectedDocument::for_call(None, tool_name, &arguments),
+            expected,
+        );
+    }
+    let arguments = json!({"operation": "documentation", "documentation_name": "confirmations"});
+    assert_eq!(
+        ProtectedDocument::for_call(Some("chrome"), "control_chrome", &arguments),
+        Some(ProtectedDocument::ChromeConfirmations),
+    );
+    assert_eq!(
+        ProtectedDocument::for_call(Some("unrelated"), "chrome__control_chrome", &arguments),
+        None,
+    );
+    assert_eq!(
+        ProtectedDocument::for_call(
+            None,
+            "chrome__control_chrome",
+            &json!({"operation": "exec", "documentation_name": "confirmations"}),
+        ),
+        None,
+    );
+}
