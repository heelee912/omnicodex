+#[tokio::test]
+async fn verification_failure_never_returns_host_content() -> Result<()> {
+    for manifest in [
+        None,
+        Some(json!([{
+            "Source": "chrome-confirmations.md",
+            "SHA256": "0".repeat(64),
+        }])),
+        Some(json!([
+            {"Source": "chrome-confirmations.md", "SHA256": "0".repeat(64)},
+            {"Source": "C:\\other\\chrome-confirmations.md", "SHA256": "0".repeat(64)},
+        ])),
+    ] {
+        let home = tempfile::tempdir()?;
+        let root = home.path().join("protected-confirmation-docs");
+        tokio::fs::create_dir(&root).await?;
+        tokio::fs::write(root.join("chrome-confirmations.md"), "# 확인\n\n한글\n").await?;
+        if let Some(manifest) = manifest {
+            tokio::fs::write(root.join("manifest.json"), serde_json::to_vec(&manifest)?).await?;
+        }
+        let mut response = host_response();
+
+        set_protected_document_response(
+            home.path(),
+            ProtectedDocument::ChromeConfirmations,
+            &mut response,
+        )
+        .await;
+
+        assert!(!response.success);
+        let serialized = serde_json::to_string(&response)?;
+        assert!(!serialized.contains("UNTRUSTED_HOST_CONTENT"));
+        assert!(serialized.contains("보호 문서 오류"));
+        assert_eq!(response.content_items.len(), 1);
+    }
+    Ok(())
+}
+
+fn host_response() -> DynamicToolResponse {
+    DynamicToolResponse {
+        content_items: vec![DynamicToolCallOutputContentItem::InputText {
+            text: "UNTRUSTED_HOST_CONTENT".to_string(),
+        }],
+        success: false,
+    }
+}
