+#[tokio::test]
+async fn protected_documentation_completes_without_host_response() {
+    let home = tempfile::tempdir().expect("temporary Codex home");
+    let root = home.path().join("protected-confirmation-docs");
+    tokio::fs::create_dir(&root)
+        .await
+        .expect("protected directory");
+    let markdown = "# 확인 정책\n\n한글 문서입니다.\n";
+    tokio::fs::write(root.join("chrome-confirmations.md"), markdown)
+        .await
+        .expect("protected Markdown");
+    let hash = format!("{:x}", Sha256::digest(markdown.as_bytes()));
+    tokio::fs::write(
+        root.join("manifest.json"),
+        serde_json::to_vec(&json!([{
+            "Source": "C:\\protected\\chrome-confirmations.md",
+            "SHA256": hash,
+        }]))
+        .expect("manifest JSON"),
+    )
+    .await
+    .expect("protected manifest");
+    let (session, turn, receiver) =
+        crate::session::tests::make_session_and_context_with_auth_config_home_and_rx(
+            CodexAuth::from_api_key("Test API Key"),
+            Vec::new(),
+            home.path(),
+            |_| {},
+        )
+        .await;
+    *session.active_turn.lock().await = Some(ActiveTurn::default());
+    let lifecycle = tokio::spawn({
+        let session = Arc::clone(&session);
+        async move {
+            request_dynamic_tool(
+                &session,
+                &turn,
+                "policy-call".to_string(),
+                ToolName::plain("chrome__control_chrome"),
+                json!({
+                    "operation": "documentation",
+                    "documentation_name": "confirmations",
+                }),
+                CancellationToken::new(),
+            )
+            .await
+        }
+    });
+
+    let started = next_item(&receiver).await;
+    assert_eq!(started.status, DynamicToolCallStatus::InProgress);
+    let response = tokio::time::timeout(Duration::from_secs(5), lifecycle)
+        .await
+        .expect("protected document should not await host")
+        .expect("dynamic tool task")
+        .expect("protected document response");
+    assert_eq!(
+        response.content_items,
+        vec![
+            codex_protocol::dynamic_tools::DynamicToolCallOutputContentItem::InputText {
+                text: markdown.to_string(),
+            }
+        ]
+    );
+    let completed = next_item(&receiver).await;
+    assert_eq!(completed.status, DynamicToolCallStatus::Completed);
+    assert_eq!(completed.content_items, Some(response.content_items));
+}
