+#[tokio::test]
+async fn reused_apps_status_keeps_the_shared_catalog_without_a_hard_refresh() {
+    let mut previous = McpConnectionSet::empty(/*prefix_mcp_tool_names*/ true);
+    let mut client = create_ready_async_managed_client(Vec::new()).await;
+    client.is_codex_apps_mcp_server = true;
+    client.client = futures::future::pending().boxed().shared();
+    previous.insert_test_client(CODEX_APPS_MCP_SERVER_NAME, client);
+
+    let mut current = McpConnectionSet::empty(/*prefix_mcp_tool_names*/ true);
+    current.servers.insert(
+        CODEX_APPS_MCP_SERVER_NAME.to_string(),
+        previous.servers[CODEX_APPS_MCP_SERVER_NAME].clone(),
+    );
+    let errors = tokio::time::timeout(
+        Duration::from_secs(1),
+        current.refresh_reused_status_catalogs(&previous),
+    )
+    .await
+    .expect("status must not start a Codex Apps hard refresh");
