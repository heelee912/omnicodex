+++ b/codex-rs/codex-mcp/src/mcp/status_connections.rs
@@ -0,0 +1,231 @@
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::atomic::Ordering;
+use std::time::Duration;
+use std::time::Instant;
+
+use tokio::sync::Mutex;
+use tokio::sync::OwnedMutexGuard;
+use tokio_util::sync::CancellationToken;
+
+use crate::connection_manager::McpConnectionSet;
+
+const STATUS_CONNECTION_IDLE_TIMEOUT: Duration = Duration::from_secs(120);
+const STATUS_CONNECTION_REAP_INTERVAL: Duration = Duration::from_secs(30);
+const STATUS_CONNECTION_SHUTDOWN_TIMEOUT: Duration = Duration::from_secs(5);
+
+/// A status request may reuse connections only within its own thread and auth origin.
+#[derive(Clone, Debug, Eq, Hash, PartialEq)]
+pub enum McpStatusScope {
+    Threadless {
+        auth_originator: String,
+        selected_server: Option<String>,
+    },
+    Thread {
+        thread_id: String,
+        auth_originator: String,
+        selected_server: Option<String>,
+    },
+}
+
+pub(super) struct RetainedStatusSet {
+    pub(super) connections: Option<Arc<McpConnectionSet>>,
+    pub(super) cancel_token: CancellationToken,
+    in_flight: Arc<()>,
+    last_used_at: Instant,
+}
+
+impl RetainedStatusSet {
+    fn new() -> Self {
+        let now = Instant::now();
+        Self {
+            connections: None,
+            cancel_token: CancellationToken::new(),
+            in_flight: Arc::new(()),
+            last_used_at: now,
+        }
+    }
+
+    pub(super) async fn reset(&mut self) {
+        if self
+            .connections
+            .as_ref()
+            .is_some_and(|connections| Arc::strong_count(connections) > 1)
+            || Arc::strong_count(&self.in_flight) > 1
+        {
+            return;
+        }
+        self.stop().await;
+        self.cancel_token = CancellationToken::new();
+        self.last_used_at = Instant::now();
+    }
+
+    async fn stop(&mut self) {
+        self.cancel_token.cancel();
+        if let Some(connections) = self.connections.take()
+            && tokio::time::timeout(STATUS_CONNECTION_SHUTDOWN_TIMEOUT, connections.shutdown())
+                .await
+                .is_err()
+        {
+            tracing::warn!("timed out stopping idle MCP status connections");
+        }
+    }
+
+    pub(super) fn touch(&mut self) {
+        self.last_used_at = Instant::now();
+    }
+
+    pub(super) fn lease(&self) -> Arc<()> {
+        Arc::clone(&self.in_flight)
+    }
+
+    fn should_reap(&self) -> bool {
+        self.last_used_at.elapsed() >= STATUS_CONNECTION_IDLE_TIMEOUT
+            && Arc::strong_count(&self.in_flight) == 1
+            && self
+                .connections
+                .as_ref()
+                .is_none_or(|connections| Arc::strong_count(connections) == 1)
+    }
+}
+
+impl Drop for RetainedStatusSet {
+    fn drop(&mut self) {
+        self.cancel_token.cancel();
+    }
+}
+
+#[derive(Default)]
+struct StatusConnectionsInner {
+    scopes: Mutex<HashMap<McpStatusScope, Arc<Mutex<RetainedStatusSet>>>>,
+    reaper_started: AtomicBool,
+}
+
+impl StatusConnectionsInner {
+    async fn reap_expired(&self) {
+        let expired = {
+            let mut scopes = self.scopes.lock().await;
+            let mut expired = Vec::new();
+            scopes.retain(|_, slot| {
+                // A caller that already selected this slot must finish before it can be removed.
+                if Arc::strong_count(slot) != 1 {
+                    return true;
+                }
+                let should_reap = slot.try_lock().is_ok_and(|status| status.should_reap());
+                if should_reap {
+                    expired.push(Arc::clone(slot));
+                }
+                !should_reap
+            });
+            expired
+        };
+        for slot in expired {
+            slot.lock().await.stop().await;
+        }
+    }
+}
+
+/// Keeps the app server's status connections alive between UI polling requests.
+#[derive(Clone, Default)]
+pub struct McpStatusConnections {
+    inner: Arc<StatusConnectionsInner>,
+}
+
+impl McpStatusConnections {
+    pub(super) async fn lock(&self, scope: McpStatusScope) -> OwnedMutexGuard<RetainedStatusSet> {
+        self.start_reaper();
+        let slot = {
+            let mut scopes = self.inner.scopes.lock().await;
+            Arc::clone(
+                scopes
+                    .entry(scope)
+                    .or_insert_with(|| Arc::new(Mutex::new(RetainedStatusSet::new()))),
+            )
+        };
+        slot.lock_owned().await
+    }
+
+    fn start_reaper(&self) {
+        if self.inner.reaper_started.swap(true, Ordering::AcqRel) {
+            return;
+        }
+        let weak = Arc::downgrade(&self.inner);
+        tokio::spawn(async move {
+            let mut interval = tokio::time::interval(STATUS_CONNECTION_REAP_INTERVAL);
+            loop {
+                interval.tick().await;
+                let Some(inner) = weak.upgrade() else {
+                    break;
+                };
+                inner.reap_expired().await;
+            }
+        });
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn scope(thread_id: &str) -> McpStatusScope {
+        McpStatusScope::Thread {
+            thread_id: thread_id.to_owned(),
+            auth_originator: "test".to_owned(),
+            selected_server: None,
+        }
+    }
+
+    #[tokio::test]
+    async fn status_scopes_serialize_their_own_requests_and_reap_idle_connections() {
+        let connections = McpStatusConnections::default();
+        let first_scope = scope("first");
+        let second_scope = scope("second");
+        let mut first = connections.lock(first_scope.clone()).await;
+        let first_token = first.cancel_token.clone();
+
+        let first_slot = {
+            let scopes = connections.inner.scopes.lock().await;
+            Arc::clone(scopes.get(&first_scope).expect("first scope"))
+        };
+        assert!(first_slot.try_lock().is_err());
+
+        let second = tokio::time::timeout(
+            Duration::from_secs(1),
+            connections.lock(second_scope.clone()),
+        )
+        .await
+        .expect("another thread's status request should not wait");
+        let second_token = second.cancel_token.clone();
+        drop(second);
+
+        let in_flight = first.lease();
+        first.last_used_at = Instant::now() - STATUS_CONNECTION_IDLE_TIMEOUT;
+        drop(first);
+        drop(first_slot);
+        connections.inner.reap_expired().await;
+
+        assert!(!first_token.is_cancelled());
+        drop(in_flight);
+        connections.inner.reap_expired().await;
+
+        assert!(first_token.is_cancelled());
+        assert!(!second_token.is_cancelled());
+        assert!(
+            !connections
+                .inner
+                .scopes
+                .lock()
+                .await
+                .contains_key(&first_scope)
+        );
+        assert!(
+            connections
+                .inner
+                .scopes
+                .lock()
+                .await
+                .contains_key(&second_scope)
+        );
+    }
+}
