+        replace_server_entry(&mut self.tools_by_server, &mut source.tools_by_server, name);
+        replace_server_entry(&mut self.tools_errors, &mut source.tools_errors, name);
+        replace_server_entry(&mut self.resources, &mut source.resources, name);
+        replace_server_entry(
+            &mut self.resource_templates,
+            &mut source.resource_templates,
+            name,
+        );
+        replace_server_entry(&mut self.auth_statuses, &mut source.auth_statuses, name);
+        if source.server_names.iter().any(|server| server == name)
+            && !self.server_names.iter().any(|server| server == name)
+        {
+            self.server_names.push(name.to_owned());
+        }
+    }
+}
+
+fn replace_server_entry<Value>(
+    target: &mut HashMap<String, Value>,
+    source: &mut HashMap<String, Value>,
+    name: &str,
+) {
+    target.remove(name);
+    if let Some(value) = source.remove(name) {
+        target.insert(name.to_owned(), value);
+    }
+}
