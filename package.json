{
  "name": "@heelee912/omnicodex",
  "version": "0.0.0-development",
  "description": "Expose the installed Codex native tool surface as an authenticated remote MCP without model delegation.",
  "type": "module",
  "bin": {
    "omnicodex": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "scripts/windows/install.ps1",
    "scripts/windows/uninstall.ps1",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/ensure-cli-executable.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "tsx src/cli.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:live:daemon": "npm run build && node scripts/daemon-smoke.mjs",
    "test:live:runtime": "npm run build && node scripts/gateway-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "codex",
    "mcp",
    "model-context-protocol",
    "windows",
    "gateway"
  ],
  "author": "heelee912",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heelee912/omnicodex.git"
  },
  "bugs": {
    "url": "https://github.com/heelee912/omnicodex/issues"
  },
  "homepage": "https://github.com/heelee912/omnicodex#readme",
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "nanoid": "3.3.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "jose": "6.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "26.1.1",
    "fast-check": "4.9.0",
    "selfsigned": "^5.5.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
