{
  "name": "@heelee912/omnicodex",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Expose the installed Codex native tool surface as an authenticated remote MCP without model delegation.",
  "type": "module",
  "bin": {
    "omnicodex": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/README.ko.md",
    "docs/README.ja.md",
    "docs/README.zh.md",
    "docs/reference-ledger.md",
    "docs/windows-cua-document-role-repair.md",
    "scripts/connectors/hosted-mcp/config.mjs",
    "scripts/connectors/hosted-mcp/config-store.mjs",
    "scripts/connectors/hosted-mcp/setup.mjs",
    "scripts/connectors/hosted-mcp/state.mjs",
    "scripts/connectors/hosted-mcp/audit.mjs",
    "scripts/connectors/hosted-mcp/hosted-connector.mjs",
    "scripts/connectors/hosted-mcp/oauth-credential.mjs",
    "scripts/connectors/hosted-mcp/oauth-login.mjs",
    "scripts/connectors/hosted-mcp/stdio.mjs",
    "scripts/connectors/hosted-mcp/windows-dpapi.ps1",
    "scripts/connectors/hosted-mcp/windows-private-config.ps1",
    "scripts/connectors/hosted-mcp/windows-private-state.ps1",
    "scripts/connectors/hosted-mcp/README.md",
    "scripts/oracle/*.mjs",
    "scripts/oracle/*.ps1",
    "scripts/oracle/a1_capacity_catcher.py",
    "scripts/oracle/install-managed-caddy.py",
    "scripts/oracle/oracle-browser-profile.py",
    "scripts/oracle/provision-a1-network.py",
    "scripts/oracle/*.service",
    "scripts/oracle/*.sh",
    "scripts/oracle/*.timer",
    "scripts/windows/desktop-engine",
    "scripts/windows/install.ps1",
    "scripts/windows/start-omnicodex2-tunnel.ps1",
    "scripts/windows/uninstall.ps1",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/ensure-cli-executable.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "tsx src/cli.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:live:daemon": "npm run build && node scripts/daemon-smoke.mjs",
    "test:live:drain": "npm run build && node scripts/daemon-drain-smoke.mjs",
    "test:live:package": "npm run build && node scripts/package-transition-smoke.mjs",
    "test:live:runtime": "npm run build && node scripts/gateway-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "keywords": [
    "codex",
    "mcp",
    "model-context-protocol",
    "windows",
    "gateway"
  ],
  "author": "heelee912",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heelee912/omnicodex.git"
  },
  "bugs": {
    "url": "https://github.com/heelee912/omnicodex/issues"
  },
  "homepage": "https://github.com/heelee912/omnicodex#readme",
  "overrides": {
    "@hono/node-server": "2.1.7",
    "fast-uri": "3.1.9",
    "hono": "4.13.18",
    "nanoid": "3.3.18"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "jose": "6.2.4",
    "typescript-legacy": "npm:typescript@5.9.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "26.1.1",
    "fast-check": "4.9.0",
    "selfsigned": "^5.5.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
